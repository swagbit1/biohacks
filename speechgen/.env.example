# Variables used by speechgen. Next reads the ROOT .env.local, so set these there
# (this file only documents them). Never commit real keys.
#
# Optional: enables context reranking of glide candidates, server-side only.
# Without it the decoder's own ranking is used and everything else works.
GEMINI_API_KEY=
# Optional: override the Gemini model used for reranking.
GEMINI_MODEL=gemini-2.5-flash
